# /etc/nginx/sites-available/seasonkart   (then: sudo ln -s ../sites-available/seasonkart /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx)
# Start with this plain-HTTP block, then run:  sudo certbot --nginx -d yourshop.com -d www.yourshop.com
# Certbot adds the HTTPS server block and the http->https redirect for you.
server {
    listen 80;
    server_name yourshop.com www.yourshop.com;

    client_max_body_size 8m;            # product photo uploads (the app limits each photo to 6 MB)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;
    gzip_min_length 1024;

    # product photos straight from disk (fast, cached by browsers for 30 days; file names are random so this is safe)
    location /uploads/ {
        alias /var/www/seasonkart/public/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
