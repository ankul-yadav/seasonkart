# Minimal settings to run the shop on YOUR OWN COMPUTER (VS Code). Copy this file to ".env" and set DB_PASS.
PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=root
# your MySQL root password (XAMPP default: leave empty)
DB_PASS=
DB_NAME=seasonkart
# any long text is fine on your own computer (32+ characters). Use a random one on a real server.
JWT_SECRET=local-development-secret-change-me-0123456789abcdef
# the first start creates this admin. Log in at http://localhost:3000/#admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
BASE_URL=http://localhost:3000
STORE_NAME=SeasonKart
STORE_STATE=Maharashtra
# Leave everything else empty at first. The shop works without it:
#   Razorpay keys   -> online payment (only Cash on delivery until you add test keys)
#   SMTP_*          -> emails (without it, emails are printed in this terminal instead)
#   TWILIO_*, WA_*  -> SMS / WhatsApp / COD OTP
#   SHIPROCKET_*    -> courier
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
