PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASS=yourpassword
DB_NAME=seasonkart
# For a remote database, set DB_SSL=1 and install its CA certificate as DB_SSL_CA.
DB_PORT=3306
DB_SSL=0
DB_SSL_CA=
# REQUIRED: 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@seasonkart.com
ADMIN_PASSWORD=change-this-password
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public URL of your store (used for tracking links in messages)
BASE_URL=http://localhost:3000
# Optional persistent upload location (Render: /var/data/uploads)
UPLOAD_DIR=
# Email (any SMTP: Gmail app password, Brevo, Zoho, SES...). Leave blank to skip emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SeasonKart <orders@yourdomain.com>
ADMIN_NOTIFY_EMAIL=
# SMS via Twilio. Leave blank to skip SMS.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Razorpay webhook secret (set the same string in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Required to deliver supplier order callbacks. Configure a random 32+ character secret
# and have each supplier verify X-SeasonKart-Signature against the exact raw JSON body.
SUPPLIER_WEBHOOK_SECRET=
# Applies to payment and supplier webhook network calls.
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_BODY_LIMIT_BYTES=65536
WEBHOOK_RESPONSE_LIMIT_BYTES=16384
RETURN_DAYS=7
UNPAID_MINUTES=30

# --- Production / security ---
NODE_ENV=production
# Set to 1 if you run behind nginx / Render / Railway / Cloudflare (needed for correct rate limiting)
TRUST_PROXY=1
# Set to 1 to redirect http -> https (only after HTTPS works and TRUST_PROXY is set)
FORCE_HTTPS=0
# --- Store details shown on policy pages ---
STORE_NAME=SeasonKart
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
STORE_GSTIN=
GRIEVANCE_OFFICER=
SHIP_DAYS=5-9

# --- GST invoices (leave STORE_GSTIN blank if you are not GST-registered: invoices then show no tax split) ---
STORE_GSTIN=
# Your state, exactly as in the list, e.g. Maharashtra. Same-state buyers get CGST+SGST, others IGST.
STORE_STATE=
# Invoice shipping tax requires the accountant-confirmed shipping service category.
# Leave blank until configured; invoices with shipping charges are blocked while blank.
SHIPPING_GST_RATE=
SHIPPING_HSN=

# --- Courier: Shiprocket (optional; leave blank to enter tracking numbers by hand) ---
# Create an API user at Shiprocket > Settings > API > Configure (NOT your panel login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of your pickup address in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# 6-digit pincode you ship from (used for delivery-time / serviceability checks)
PICKUP_PINCODE=
# Extra days added to courier estimate for packing
HANDLING_DAYS=1
# Default parcel size in cm
PKG_LENGTH=25
PKG_BREADTH=20
PKG_HEIGHT=5

# --- SEO ---
# BASE_URL (above) MUST be your public https address (https://www.yourshop.com) - used for canonical links, sitemap and WhatsApp/Google previews
# Home-page description shown in Google (about 150 characters). Optional.
SEO_DESCRIPTION=

# --- COD OTP (set to 1 to make customers verify their phone with a 6-digit OTP before a Cash-on-delivery order) ---
# Needs a working OTP channel: WhatsApp (WA_TEMPLATE_OTP below) and/or Twilio SMS above. Repeat customers (1+ delivered order) skip it.
COD_OTP=0
# Max OTP messages sent per day across the whole shop (protects you from SMS/WhatsApp bills if someone abuses the form)
OTP_DAILY_LIMIT=300

# --- WhatsApp Business Cloud API (Meta). Optional: WhatsApp is tried first, SMS is the fallback ---
WA_TOKEN=
# Phone number ID (not the phone number) from Meta > WhatsApp > API setup
WA_PHONE_ID=
WA_LANG=en
WA_API_VERSION=v23.0
# Names of your APPROVED templates (see README for the exact texts to submit). Leave a template blank to use SMS for that message.
WA_TEMPLATE_OTP=
WA_TEMPLATE_ORDER_CONFIRMED=
WA_TEMPLATE_SHIPPED=
WA_TEMPLATE_DELIVERED=
WA_TEMPLATE_CANCELLED=
WA_TEMPLATE_RETURN=

# --- Backups (scripts/backup.sh, see DEPLOY.md) ---
# Folder for backup files (default: ./backups). The admin dashboard reads "last backup" from here.
# Render: /var/data/backups (configure an external scheduled backup; see DEPLOY.md).
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone, e.g. gdrive:seasonkart-backups or b2:my-bucket/seasonkart (leave blank to skip - but then a dead server = lost data)
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=60
# Optional: encrypt backups (they contain customer names, phones and addresses). KEEP THIS SAFE - without it the backups cannot be restored.
BACKUP_PASSPHRASE=
# Optional: https://healthchecks.io ping URL - emails you if a nightly backup does not report in
HC_PING_URL=

# --- Selling any kind of product ---
# Maximum order value allowed for Cash on delivery (0 = no limit). Higher orders must pay online.
COD_MAX=0
